#!/system/bin/sh

source /data/adb/box/settings.ini

tun_device="sing"
fwmark="16777216/16777216"
table="2022"
pref="100"
fake_ip_range=""
fake_ip6_range=""

buildVersion=$(getprop ro.build.version.release)
minBuildVersion="11"
IPV="iptables"
IP6V="ip6tables"
buildVersionMajor=${buildVersion%%.*}
if [ "$buildVersionMajor" -ge "$minBuildVersion" ]; then
  IPV="iptables -w 100"
  IP6V="ip6tables -w 100"
fi

case "${bin_name}" in
  "mihomo")
    mihomo_mode=$(busybox awk '!/^ *#/ && /mode: / { print $2;found=1; exit } END{ if(!found) print "rules" }' "${mihomo_config}" 2>/dev/null)
    mihomo_enhanced_mode=$(busybox awk '!/^ *#/ && /enhanced-mode: / { print $2;found=1; exit } END{ if(!found) print "fake-ip" }' "${mihomo_config}" 2>/dev/null)
    fake_ip_range=$(busybox awk '!/^ *#/ && /fake-ip-range:/ { print $2; found=1; exit } END { if (!found) print "198.18.0.1/16" }' "${mihomo_config}" 2>/dev/null)
    fake_ip6_range=$(busybox awk '!/^ *#/ && /fake-ip-range6:/ { print $2; found=1; exit } END { if (!found) print "fc00::/18" }' "${mihomo_config}" 2>/dev/null)
    mihomo_dns_port=$(sed -n '/^dns:/,/^[^ ]/p' "${mihomo_config}" | grep -E '^[^#]*listen:.*:[0-9]+' | grep -Eo '[0-9]+' | tail -n 1)
    mihomo_dns_port=${mihomo_dns_port:-1053}
    if [[ "${network_mode}" == @(mixed|tun) ]]; then
      tun_device=$(busybox awk '!/^ *#/ && /device: / { print $2;found=1; exit } END{ if(!found) print "meta" }' "${mihomo_config}" 2>/dev/null)
    fi
    ;;
  "sing-box")
    if [[ "${network_mode}" == @(mixed|tun) ]]; then
      tun_device=$(busybox grep -oE '"interface_name": "[^"]*' "${sing_config}" | busybox awk -F'"' '{print $4}' 2>/dev/null | head -n 1)
      if [ -z "$tun_device" ]; then
        tun_device="sing"
      fi
    fi
    fake_ip_range=$(busybox awk -F'"' '/inet4_range/ {print $4}' "${sing_config}")
    fake_ip6_range=$(busybox awk -F'"' '/inet6_range/ {print $4}' "${sing_config}")
    ;;
  "hysteria")
    case "${network_mode}" in
      redirect|tproxy|enhance)
        true
        ;;
      *)
        log Warning "$bin_name 不支持 network_mode: $network_mode，已切换回 TProxy"
        sed -i 's/\(network_mode=\)\"[^\"]*\"/\1"tproxy"/g' ${settings}
        ;;
    esac
    ;;
  "xray" | "v2fly")
    if [[ "${network_mode}" != "tproxy" ]]; then
      log Warning "$bin_name 不支持 network_mode: $network_mode，已切换回 TProxy"
      sed -i 's/\(network_mode=\)\"[^\"]*\"/\1"tproxy"/g' ${settings}
    fi
    ;;
  *)
    log Error "<${bin_name}> 未知内核。"
    exit 1
    ;;
esac

runtime_env="${box_run}/runtime.iptables.env"

runtime_save() {
  mkdir -p "${box_run}" 2>/dev/null || true
  {
    printf 'network_mode="%s"\n' "${network_mode}"
    printf 'bin_name="%s"\n'     "${bin_name}"
    printf 'ipv6="%s"\n'         "${ipv6}"
    printf 'dns_hijack_mode="%s"\n' "${dns_hijack_mode}"
    printf 'mihomo_dns_forward="%s"\n' "${mihomo_dns_forward}"
    printf 'quic="%s"\n'         "${quic}"
    printf 'fwmark="%s"\n'       "${fwmark}"
    printf 'table="%s"\n'        "${table}"
    printf 'pref="%s"\n'         "${pref}"
    printf 'tproxy_port="%s"\n'  "${tproxy_port}"
    printf 'redir_port="%s"\n'   "${redir_port}"
    printf 'bypass_cn_ip="%s"\n' "${bypass_cn_ip}"
    printf 'bypass_cn_ip_v4="%s"\n' "${bypass_cn_ip_v4}"
    printf 'bypass_cn_ip_v6="%s"\n' "${bypass_cn_ip_v6}"
    printf 'box_user="%s"\n'     "${box_user}"
    printf 'box_group="%s"\n'    "${box_group}"
  } > "${runtime_env}" 2>/dev/null
  log Debug "runtime snapshot 已保存: ${runtime_env}"
}

runtime_load() {
  [ -f "${runtime_env}" ] || return 1
  . "${runtime_env}"
  log Debug "runtime snapshot 已加载: ${runtime_env}"
}

runtime_clear() {
  rm -f "${runtime_env}" 2>/dev/null || true
}

block_quic() {
  local cmd="${IPV}"
  local cmd6="${IP6V}"
  case "$1" in
    enable)
      ${cmd} -t filter -N BLOCK_QUIC 2>/dev/null || true
      ${cmd} -t filter -F BLOCK_QUIC
      if [ "${bypass_cn_ip}" = "true" ] && [ "${bypass_cn_ip_v4}" = "true" ] && command -v ipset >/dev/null 2>&1; then
        ${cmd} -t filter -A BLOCK_QUIC -p udp --dport 443 -m set ! --match-set cnip dst -j REJECT
      else
        ${cmd} -t filter -A BLOCK_QUIC -p udp --dport 443 -j REJECT
      fi
      for chain in INPUT FORWARD OUTPUT; do
        ${cmd} -t filter -I "${chain}" -j BLOCK_QUIC
      done

      if [ "${ipv6}" = "true" ]; then
        ${cmd6} -t filter -N BLOCK_QUIC6 2>/dev/null || true
        ${cmd6} -t filter -F BLOCK_QUIC6
        if [ "${bypass_cn_ip}" = "true" ] && [ "${bypass_cn_ip_v6}" = "true" ] && command -v ipset >/dev/null 2>&1; then
          ${cmd6} -t filter -A BLOCK_QUIC6 -p udp --dport 443 -m set ! --match-set cnip6 dst -j REJECT
        else
          ${cmd6} -t filter -A BLOCK_QUIC6 -p udp --dport 443 -j REJECT
        fi
        for chain in INPUT FORWARD OUTPUT; do
          ${cmd6} -t filter -I "${chain}" -j BLOCK_QUIC6
        done
      fi
      log Info "QUIC 封锁已启用（仅封锁非 CN IP）"
      ;;
    disable)
      for chain in INPUT FORWARD OUTPUT; do
        ${cmd}  -t filter -D "${chain}" -j BLOCK_QUIC  2>/dev/null || true
        ${cmd6} -t filter -D "${chain}" -j BLOCK_QUIC6 2>/dev/null || true
      done
      ${cmd}  -t filter -F BLOCK_QUIC  2>/dev/null || true
      ${cmd}  -t filter -X BLOCK_QUIC  2>/dev/null || true
      ${cmd6} -t filter -F BLOCK_QUIC6 2>/dev/null || true
      ${cmd6} -t filter -X BLOCK_QUIC6 2>/dev/null || true
      ;;
  esac
}

cap_has_target() {
  local family="$1"
  local target="$2"
  local f
  if [ "${family}" = "6" ]; then
    f="/proc/net/ip6_tables_targets"
  else
    f="/proc/net/ip_tables_targets"
  fi
  [ -r "${f}" ] || return 1
  busybox grep -qw "${target}" "${f}"
}

cap_has_match() {
  local family="$1"
  local match="$2"
  local f
  if [ "${family}" = "6" ]; then
    f="/proc/net/ip6_tables_matches"
  else
    f="/proc/net/ip_tables_matches"
  fi
  [ -r "${f}" ] || return 1
  busybox grep -qw "${match}" "${f}"
}

probe_capabilities() {
  cap_tproxy4="false"
  cap_tproxy6="false"
  cap_socket_match="false"
  cap_ipset="false"
  cap_ip6_nat="false"

  cap_has_target 4 TPROXY && cap_tproxy4="true"
  cap_has_target 6 TPROXY && cap_tproxy6="true"
  (cap_has_match 4 socket || cap_has_match 6 socket) && cap_socket_match="true"
  command -v ipset >/dev/null 2>&1 && cap_ipset="true"
  ip6_nat_supported && cap_ip6_nat="true"

  log Debug "能力探测: TPROXY(v4=${cap_tproxy4}, v6=${cap_tproxy6}) socket_match=${cap_socket_match} ipset=${cap_ipset} ip6_nat=${cap_ip6_nat}"
}

log_context() {
  log Info "运行上下文: mode=${network_mode}, bin=${bin_name}, ipv6=${ipv6}, dns_hijack=${dns_hijack_mode}"
  log Info "运行上下文: ports(tproxy=${tproxy_port}, redir=${redir_port})"
  log Info "运行上下文: cnip(total=${bypass_cn_ip}, v4=${bypass_cn_ip_v4}, v6=${bypass_cn_ip_v6})"
  log Info "运行上下文: mac_filter(enable=${mac_filter}, mode=${mac_mode}, macs_count=${#macs_list[@]})"
  if [ "${ap_list}" != "" ]; then
    log Debug "接口 allow: ${ap_list[*]}"
  fi
  if [ "${ignore_ap_list}" != "" ]; then
    log Debug "接口 ignore: ${ignore_ap_list[*]}"
  fi
}

log_capabilities() {
  log Info "能力: tproxy4=${cap_tproxy4}, tproxy6=${cap_tproxy6}, socket_match=${cap_socket_match}, ipset=${cap_ipset}, ip6_nat=${cap_ip6_nat}"
}

apply_capability_downgrades() {
  probe_capabilities

  local _old_mode="${network_mode}"
  local _old_dns="${dns_hijack_mode}"
  local _old_cn="${bypass_cn_ip}"

  if [[ "${network_mode}" == @(tproxy|enhance) ]] && [ "${cap_tproxy4}" != "true" ]; then
    log Warning "降级: 内核不支持 TPROXY, network_mode ${network_mode} -> redirect"
    network_mode="redirect"
  fi

  if [ "${dns_hijack_mode}" = "tproxy" ] && [ "${cap_tproxy4}" != "true" ]; then
    log Warning "降级: 内核不支持 TPROXY, dns_hijack_mode tproxy -> redirect"
    dns_hijack_mode="redirect"
  fi

  if [ "${bypass_cn_ip}" = "true" ] && [ "${cap_ipset}" != "true" ]; then
    log Warning "降级: ipset 不可用, bypass_cn_ip true -> false"
    bypass_cn_ip="false"
    bypass_cn_ip_v4="false"
    bypass_cn_ip_v6="false"
  fi

  [ "${_old_mode}" != "${network_mode}" ] && log Info "最终 network_mode=${network_mode}"
  [ "${_old_dns}" != "${dns_hijack_mode}" ] && log Info "最终 dns_hijack_mode=${dns_hijack_mode}"
  [ "${_old_cn}" != "${bypass_cn_ip}" ] && log Info "最终 bypass_cn_ip=${bypass_cn_ip}"
}

box_etc() {
  case "${bin_name}" in
    mihomo)
      log Debug "增强模式: $mihomo_enhanced_mode, fake-ip 段: $fake_ip_range, fake-ip6 段: ${fake_ip6_range:-none}, DNS 端口: $mihomo_dns_port, 模式: $mihomo_mode"
      ;;
    sing-box)
      if [ -n "${fake_ip_range}" ] && [ "${bin_name}" = "sing-box" ]; then
        log Debug "fake-ip 段: ${fake_ip_range}, ${fake_ip6_range}"
      fi
      ;;
    *) 
      true 
      ;;
  esac
  if [[ "${network_mode}" == @(mixed|tun) ]]; then
    log Info "TUN 设备: ($tun_device)"
  fi
}

bin_alive() {
  local PID=$(<"${box_pid}" 2>/dev/null)
  if ! kill -0 "$PID" >/dev/null; then
    log Error "$(<"${box_run}/${bin_name}.log")"
    log Error "${bin_name} 服务未运行。"
    log Error "请检查 ${bin_name}.log 获取更多信息。"
    log Error "正在清理僵尸进程 $PID"
    for bin in "${bin_list[@]}"; do
      killall -15 "${bin}" >/dev/null 2>&1 || busybox pkill -15 "${bin}" >/dev/null 2>&1
    done
    cleanup_iptables
    [ -f "${box_pid}" ] && rm -f "${box_pid}"
    return 1
  else
    return 0
  fi
}

probe_user_group() {
  if PID=$(busybox pidof ${bin_name}) ; then
    box_user=$(stat -c %U /proc/$PID)
    box_group=$(stat -c %G /proc/$PID)
    return 0
  else
    IFS=':' read -r box_user box_group <<< "${box_user_group}"
    return 1
  fi
}

disable_ipv6() {
  sysctl -w net.ipv4.ip_forward=1
  sysctl -w net.ipv6.conf.all.forwarding=0

  sysctl -w net.ipv6.conf.all.accept_ra=0
  sysctl -w net.ipv6.conf.wlan0.accept_ra=0
  sysctl -w net.ipv6.conf.all.disable_ipv6=1
  sysctl -w net.ipv6.conf.default.disable_ipv6=1
  sysctl -w net.ipv6.conf.wlan0.disable_ipv6=1

  ip -6 rule add unreachable pref "${pref}"
} >/dev/null 2>&1

ipv6_enable() {
  sysctl -w net.ipv4.ip_forward=1
  sysctl -w net.ipv6.conf.all.forwarding=1

  sysctl -w net.ipv6.conf.all.accept_ra=2
  sysctl -w net.ipv6.conf.wlan0.accept_ra=2
  sysctl -w net.ipv6.conf.all.disable_ipv6=0
  sysctl -w net.ipv6.conf.default.disable_ipv6=0
  sysctl -w net.ipv6.conf.wlan0.disable_ipv6=0

  ip -6 rule del unreachable pref "${pref}"
} >/dev/null 2>&1

intranet=(
  0.0.0.0/8
  10.0.0.0/8
  127.0.0.0/8
  169.254.0.0/16
  172.16.0.0/12
  192.0.0.0/24
  192.0.2.0/24
  192.88.99.0/24
  192.168.0.0/16
  198.51.100.0/24
  203.0.113.0/24
  224.0.0.0/4
  240.0.0.0/4
  255.0.0.0/4
  255.255.255.0/24
  255.255.255.255/32
)
intranet+=($(ip -4 a | busybox awk '/inet/ {print $2}' | busybox grep -vE "^127.0.0.1"))

intranet6=(
  ::/128
  ::1/128
  ::ffff:0:0/96
  100::/64
  64:ff9b::/96
  2001::/32
  2001:10::/28
  2001:20::/28
  2001:db8::/32
  2002::/16
  fc00::/7
  fe80::/10
  ff00::/8
)
intranet6+=($(ip -6 a | busybox awk '/inet6/ {print $2}' | busybox grep -vE "^fe80|^::1|^fd00"))

# IPv6 NAT 支持探测
ip6_nat_supported() {
  ip6tables -t nat -L >/dev/null 2>&1
}

# CN ipset 载入/清理
setup_cn_ipset() {
  [ "${bypass_cn_ip}" = "true" ] || { log Debug "CN 分流未启用"; return 0; }
  if ! command -v ipset >/dev/null 2>&1; then
    log Warning "ipset 不可用，跳过 CN 分流"
    return 1
  fi
  local _skip_v4=0
  if ipset list cnip &>/dev/null; then
    local _cnt
    _cnt=$(ipset list cnip | busybox grep -c "^[0-9]" 2>/dev/null || echo 0)
    if [ "${_cnt}" -gt 5000 ]; then
      log Info "cnip ipset 已存在 (${_cnt} 条)，跳过重建"
      _skip_v4=1
    fi
  fi
  if [ "${_skip_v4}" = "0" ]; then
    ipset destroy cnip 2>/dev/null || true
    if [ "${bypass_cn_ip_v4}" = "true" ] && [ -f "${cn_ip_file}" ]; then
      local tmp
      tmp=$(mktemp)
      {
        echo "create cnip hash:net family inet hashsize 8192 maxelem 65536"
        awk '!/^[[:space:]]*#/ && NF > 0 {printf "add cnip %s\n", $0}' "${cn_ip_file}"
      } >"${tmp}"
      if ipset restore -f "${tmp}" 2>/dev/null; then
        log Info "已加载中国大陆 IPv4 段到 ipset: cnip"
      else
        log Warning "加载 cnip 失败"
      fi
      rm -f "${tmp}"
    else
      log Debug "跳过 IPv4 ipset 载入（未启用或文件不存在）"
    fi
  fi
  if [ "${ipv6}" = "true" ]; then
    local _skip_v6=0
    if ipset list cnip6 &>/dev/null; then
      local _cnt6
      _cnt6=$(ipset list cnip6 | busybox grep -c "^[0-9]" 2>/dev/null || echo 0)
      if [ "${_cnt6}" -gt 500 ]; then
        log Info "cnip6 ipset 已存在 (${_cnt6} 条)，跳过重建"
        _skip_v6=1
      fi
    fi
    if [ "${_skip_v6}" = "0" ]; then
      ipset destroy cnip6 2>/dev/null || true
      if [ "${bypass_cn_ip_v6}" = "true" ] && [ -f "${cn_ipv6_file}" ]; then
        local tmp6
        tmp6=$(mktemp)
        {
          echo "create cnip6 hash:net family inet6 hashsize 8192 maxelem 65536"
          awk '!/^[[:space:]]*#/ && NF > 0 {printf "add cnip6 %s\n", $0}' "${cn_ipv6_file}"
        } >"${tmp6}"
        if ipset restore -f "${tmp6}" 2>/dev/null; then
          log Info "已加载中国大陆 IPv6 段到 ipset: cnip6"
        else
          log Warning "加载 cnip6 失败"
        fi
        rm -f "${tmp6}"
      else
        log Debug "跳过 IPv6 ipset 载入（未启用或文件不存在）"
      fi
    fi
  fi
}

# CN IP 热更新：原子交换，零流量中断
# 由 crontab 在新文件下载后调用：box.iptables hotswap_cn
hotswap_cn_ipset() {
  [ "${bypass_cn_ip}" = "true" ] || { log Debug "CN 分流未启用，跳过热更新"; return 0; }
  command -v ipset >/dev/null 2>&1 || { log Warning "ipset 不可用，跳过热更新"; return 1; }
  echo "[$(date)] 开始 CN IP 热更新" >> "${crontab_log}"

  if [ "${bypass_cn_ip_v4}" = "true" ] && [ -f "${cn_ip_file}" ]; then
    ipset destroy cnip_new 2>/dev/null || true
    local tmp
    tmp=$(mktemp)
    {
      echo "create cnip_new hash:net family inet hashsize 8192 maxelem 65536"
      awk '!/^[[:space:]]*#/ && NF > 0 {printf "add cnip_new %s\n", $0}' "${cn_ip_file}"
    } >"${tmp}"
    if ipset restore -f "${tmp}" 2>/dev/null; then
      if ipset list cnip &>/dev/null; then
        ipset swap cnip_new cnip
        ipset destroy cnip_new 2>/dev/null || true
        log Info "cnip 热更新完成（swap）"
        echo "[$(date)] cnip 热更新完成（swap）" >> "${crontab_log}"
      else
        ipset destroy cnip_new 2>/dev/null || true
        local tmp2
        tmp2=$(mktemp)
        {
          echo "create cnip hash:net family inet hashsize 8192 maxelem 65536"
          awk '!/^[[:space:]]*#/ && NF > 0 {printf "add cnip %s\n", $0}' "${cn_ip_file}"
        } >"${tmp2}"
        if ipset restore -f "${tmp2}" 2>/dev/null; then
          log Info "cnip 初次创建完成"
          echo "[$(date)] cnip 初次创建完成" >> "${crontab_log}"
        else
          log Warning "cnip 初次创建失败"
          echo "[$(date)] cnip 初次创建失败" >> "${crontab_log}"
        fi
        rm -f "${tmp2}"
      fi
    else
      log Warning "cnip_new 加载失败，保留现有 cnip"
      echo "[$(date)] cnip_new 加载失败，保留现有 cnip" >> "${crontab_log}"
      ipset destroy cnip_new 2>/dev/null || true
    fi
    rm -f "${tmp}"
  fi

  if [ "${ipv6}" = "true" ] && [ "${bypass_cn_ip_v6}" = "true" ] && [ -f "${cn_ipv6_file}" ]; then
    ipset destroy cnip6_new 2>/dev/null || true
    local tmp6
    tmp6=$(mktemp)
    {
      echo "create cnip6_new hash:net family inet6 hashsize 8192 maxelem 65536"
      awk '!/^[[:space:]]*#/ && NF > 0 {printf "add cnip6_new %s\n", $0}' "${cn_ipv6_file}"
    } >"${tmp6}"
    if ipset restore -f "${tmp6}" 2>/dev/null; then
      if ipset list cnip6 &>/dev/null; then
        ipset swap cnip6_new cnip6
        ipset destroy cnip6_new 2>/dev/null || true
        log Info "cnip6 热更新完成（swap）"
        echo "[$(date)] cnip6 热更新完成（swap）" >> "${crontab_log}"
      else
        ipset destroy cnip6_new 2>/dev/null || true
        local tmp62
        tmp62=$(mktemp)
        {
          echo "create cnip6 hash:net family inet6 hashsize 8192 maxelem 65536"
          awk '!/^[[:space:]]*#/ && NF > 0 {printf "add cnip6 %s\n", $0}' "${cn_ipv6_file}"
        } >"${tmp62}"
        if ipset restore -f "${tmp62}" 2>/dev/null; then
          log Info "cnip6 初次创建完成"
          echo "[$(date)] cnip6 初次创建完成" >> "${crontab_log}"
        else
          log Warning "cnip6 初次创建失败"
          echo "[$(date)] cnip6 初次创建失败" >> "${crontab_log}"
        fi
        rm -f "${tmp62}"
      fi
    else
      log Warning "cnip6_new 加载失败，保留现有 cnip6"
      echo "[$(date)] cnip6_new 加载失败，保留现有 cnip6" >> "${crontab_log}"
      ipset destroy cnip6_new 2>/dev/null || true
    fi
    rm -f "${tmp6}"
  fi
  echo "[$(date)] CN IP 热更新完成" >> "${crontab_log}"
}

cleanup_cn_ipset() {
  command -v ipset >/dev/null 2>&1 || return 0
  ipset destroy cnip 2>/dev/null || true
  ipset destroy cnip6 2>/dev/null || true
}

# ─────────────────────────────────────────────
# localnet ipset：内网 IP 段快速匹配（含动态本机 IP）
# ─────────────────────────────────────────────
_localnet_ipset_ready=0
_localnet6_ipset_ready=0

setup_localnet_ipset() {
  if ! command -v ipset >/dev/null 2>&1; then
    log Debug "ipset 不可用，内网 IP 将使用 iptables 规则回退"
    _localnet_ipset_ready=0
    _localnet6_ipset_ready=0
    return 1
  fi

  ipset destroy localnet 2>/dev/null || true
  if ipset create localnet hash:net family inet hashsize 64 maxelem 64 2>/dev/null; then
    local _add_ok=0
    for subnet in "${intranet[@]}"; do
      if ipset add localnet "${subnet}" 2>/dev/null || \
         ipset add localnet "${subnet%%/*}/32" 2>/dev/null; then
        _add_ok=1
      fi
    done
    if [ "${_add_ok}" = "1" ]; then
      _localnet_ipset_ready=1
      log Info "localnet ipset 就绪 (${#intranet[@]} 条)"
    else
      log Warning "localnet ipset 创建失败，将使用 iptables 规则回退"
      _localnet_ipset_ready=0
    fi
  else
    log Warning "localnet ipset 创建失败，将使用 iptables 规则回退"
    _localnet_ipset_ready=0
  fi

  ipset destroy localnet6 2>/dev/null || true
  local tmp6
  tmp6=$(mktemp) || { _localnet6_ipset_ready=0; return 0; }
  {
    echo "create localnet6 hash:net family inet6 hashsize 64 maxelem 64"
    for subnet6 in "${intranet6[@]}"; do
      echo "add localnet6 ${subnet6}"
    done
  } >"${tmp6}"
  if ipset restore -f "${tmp6}" 2>/dev/null; then
    _localnet6_ipset_ready=1
    log Info "localnet6 ipset 就绪 (${#intranet6[@]} 条)"
  else
    log Warning "localnet6 ipset 创建失败，将使用 iptables 规则回退"
    _localnet6_ipset_ready=0
  fi
  rm -f "${tmp6}"
}

cleanup_localnet_ipset() {
  command -v ipset >/dev/null 2>&1 || return 0
  ipset destroy localnet 2>/dev/null || true
  ipset destroy localnet6 2>/dev/null || true
  _localnet_ipset_ready=0
  _localnet6_ipset_ready=0
}

# ─────────────────────────────────────────────
# Google 防火墙拦截规则清理
# 清理 fw_INPUT / fw_OUTPUT 链中由运营商或系统注入的 REJECT 规则
# ─────────────────────────────────────────────
clean_google_fw_rules() {
  [ "${clean_google_rules}" = "true" ] || { log Debug "Google 防火墙清理未启用"; return 0; }
  local _chains="fw_INPUT fw_OUTPUT"
  log Info "开始清理 Google 防火墙 REJECT 规则..."
  echo "[$(date)] 开始清理 Google 防火墙 REJECT 规则" >> "${crontab_log}"

  for _chain in ${_chains}; do
    for _proto in ipv4 ipv6; do
      local _cmd
      [ "${_proto}" = "ipv4" ] && _cmd="${IPV}" || _cmd="${IP6V}"
      command -v "${_cmd%% *}" >/dev/null 2>&1 || continue

      ${_cmd} -t filter -L "${_chain}" >/dev/null 2>&1 || continue

      local _reject_lines
      _reject_lines=$(${_cmd} -t filter -nvL "${_chain}" --line-numbers 2>/dev/null | busybox awk '/REJECT/{print $1}' | sort -nr)
      if [ -z "${_reject_lines}" ]; then
        echo "[$(date)] ${_proto}: ${_chain} 无 REJECT 规则" >> "${crontab_log}"
        continue
      fi
      echo "${_reject_lines}" | while read -r _lnum; do
        [ -z "${_lnum}" ] && continue
        if ${_cmd} -t filter -D "${_chain}" "${_lnum}" 2>/dev/null; then
          log Info "已删除 (${_proto}) ${_chain} 第 ${_lnum} 行 REJECT 规则"
          echo "[$(date)] 已删除 (${_proto}) ${_chain} #${_lnum}" >> "${crontab_log}"
        else
          echo "[$(date)] 删除失败 (${_proto}) ${_chain} #${_lnum}" >> "${crontab_log}"
        fi
      done
    done
  done
  log Info "Google 防火墙 REJECT 规则清理完成"
  echo "[$(date)] Google 防火墙清理完成" >> "${crontab_log}"
}

# 新增：為 NAT 表的 DNS 劫持鏈應用 UID 黑白名單過濾（僅遵守 proxy_mode）
apply_nat_dns_bypass() {
  local chain="$1"
  local target_chain="$2"

  case "${proxy_mode}" in
    core)
      ;;
    blacklist|black)
      if [ "${gid_list}" != "" ] ; then
        for gid in ${gid_list[@]} ; do
          ${iptables} -t nat -A "${chain}" -m owner --gid-owner ${gid} -j RETURN
        done
      fi
      if [ -s "${uid_list}" ] ; then
        while read -r appid; do
          ${iptables} -t nat -A "${chain}" -m owner --uid-owner "${appid}" -j RETURN
        done < "${uid_list}"
      fi
      ;;
    whitelist|white)
      if [ -s "${uid_list}" ] ; then
        while read -r appid; do
          ${iptables} -t nat -A "${chain}" -m owner --uid-owner "${appid}" -j "${target_chain}"
        done < "${uid_list}"
      fi
      if [ "${gid_list}" != "" ] ; then
        for gid in ${gid_list[@]} ; do
          ${iptables} -t nat -A "${chain}" -m owner --gid-owner ${gid} -j "${target_chain}"
        done
      fi
      ${iptables} -t nat -A "${chain}" -m owner --uid-owner 0 -j "${target_chain}"
      ${iptables} -t nat -A "${chain}" -m owner --uid-owner 1052 -j "${target_chain}"
      
      ${iptables} -t nat -A "${chain}" -j RETURN
      ;;
  esac
  
  ${iptables} -t nat -A "${chain}" -j "${target_chain}"
}

probe_tun_device() {
  local count=0
  while [ $count -lt 10 ]; do
    if busybox ifconfig "${tun_device}" >/dev/null 2>&1; then
      return 0
    fi
    sleep 1
    count=$((count + 1))
  done
  return 1
}

forward() {
  local action=$1

  ${iptables} "${action}" FORWARD -i "${tun_device}" -j ACCEPT
  ${iptables} "${action}" FORWARD -o "${tun_device}" -j ACCEPT

  sysctl -w net.ipv4.ip_forward=1
  sysctl -w net.ipv4.conf.default.rp_filter=2
  sysctl -w net.ipv4.conf.all.rp_filter=2

} >/dev/null 2>&1

start_redirect() {
  if [ "${iptables}" = "$IP6V" ] && [ "${dns_hijack_mode}" = "redirect" ] && ip6_nat_supported; then
    local _dns_port6
    _dns_port6="${mihomo_dns_port}"; [ -z "${_dns_port6}" ] && _dns_port6="1053"
    ${iptables} -t nat -N NAT_DNS_HIJACK6 2>/dev/null || true
    ${iptables} -t nat -F NAT_DNS_HIJACK6
    ${iptables} -t nat -A NAT_DNS_HIJACK6 -m owner --uid-owner "${box_user}" --gid-owner "${box_group}" -j RETURN
    if [ "${ignore_ap_list}" != "" ]; then
      for ignore in ${ignore_ap_list[@]} ; do
        ${iptables} -t nat -A NAT_DNS_HIJACK6 -i "${ignore}" -j RETURN
      done
    fi
    ${iptables} -t nat -N BOX_DNS_REDIRECT6 2>/dev/null || true
    ${iptables} -t nat -F BOX_DNS_REDIRECT6
    ${iptables} -t nat -A BOX_DNS_REDIRECT6 -p tcp --dport 53 -j REDIRECT --to-ports "${_dns_port6}"
    ${iptables} -t nat -A BOX_DNS_REDIRECT6 -p udp --dport 53 -j REDIRECT --to-ports "${_dns_port6}"
    apply_nat_dns_bypass "NAT_DNS_HIJACK6" "BOX_DNS_REDIRECT6"
    ${iptables} -t nat -I PREROUTING -j NAT_DNS_HIJACK6
    ${iptables} -t nat -I OUTPUT -j NAT_DNS_HIJACK6
  fi
  if [ "${iptables}" = "$IPV" ]; then
    ${iptables} -t nat -N BOX_EXTERNAL
    ${iptables} -t nat -F BOX_EXTERNAL
    ${iptables} -t nat -N BOX_LOCAL
    ${iptables} -t nat -F BOX_LOCAL
  fi

  if [ "${iptables}" = "$IPV" ]; then
    if [ "${dns_hijack_mode}" = "redirect" ]; then
      local _dns_port
      _dns_port="${mihomo_dns_port}"
      [ -z "${_dns_port}" ] && _dns_port="1053"
      ${iptables} -t nat -N NAT_DNS_HIJACK 2>/dev/null || true
      ${iptables} -t nat -F NAT_DNS_HIJACK
      ${iptables} -t nat -A NAT_DNS_HIJACK -m owner --uid-owner "${box_user}" --gid-owner "${box_group}" -j RETURN
      if [ "${ignore_ap_list}" != "" ]; then
        for ignore in ${ignore_ap_list[@]} ; do
          ${iptables} -t nat -A NAT_DNS_HIJACK -i "${ignore}" -j RETURN
        done
      fi
      ${iptables} -t nat -N BOX_DNS_REDIRECT 2>/dev/null || true
      ${iptables} -t nat -F BOX_DNS_REDIRECT
      ${iptables} -t nat -A BOX_DNS_REDIRECT -p tcp --dport 53 -j REDIRECT --to-ports "${_dns_port}"
      ${iptables} -t nat -A BOX_DNS_REDIRECT -p udp --dport 53 -j REDIRECT --to-ports "${_dns_port}"
      apply_nat_dns_bypass "NAT_DNS_HIJACK" "BOX_DNS_REDIRECT"
      ${iptables} -t nat -I PREROUTING -j NAT_DNS_HIJACK
      ${iptables} -t nat -I OUTPUT -j NAT_DNS_HIJACK
    fi
    if [ "${dns_hijack_mode}" != "redirect" ] && [ "${dns_hijack_mode}" != "disable" ] && [ "${bin_name}" = "mihomo" ]; then
      ${iptables} -t nat -A BOX_EXTERNAL -p udp --dport 53 -j REDIRECT --to-ports "${mihomo_dns_port}"
      ${iptables} -t nat -A BOX_LOCAL -p udp --dport 53 -j REDIRECT --to-ports "${mihomo_dns_port}"
    fi

    ${iptables} -t nat -N LOCAL_IP_V4
    ${iptables} -t nat -F LOCAL_IP_V4
    
    for subnet in ${intranet[@]} ; do
      ${iptables} -t nat -A BOX_EXTERNAL -d ${subnet} -j RETURN
      ${iptables} -t nat -A BOX_LOCAL -d ${subnet} -j RETURN
    done
    if [ -n "$bypass_blacklist" ]; then
      for ITEM in $bypass_blacklist; do
        if [ "${ITEM#*:}" != "$ITEM" ]; then
          USER_ID="${ITEM%%:*}"
          PKG="${ITEM#*:}"
        else
          USER_ID=0
          PKG="$ITEM"
        fi
        
        BASE_UID=$(awk -v pkg="$PKG" '$1 == pkg {print $2; exit}' /data/system/packages.list 2>/dev/null)
        
        if [ -n "$BASE_UID" ] && [ -n "$USER_ID" ] && [ -z "${USER_ID//[0-9]/}" ] && [ -z "${BASE_UID//[0-9]/}" ]; then
          ACTUAL_UID=$((USER_ID * 100000 + BASE_UID))
                    
          ${iptables} -t nat -A BOX_LOCAL -p tcp -m owner --uid-owner "$ACTUAL_UID" -j REDIRECT --to-ports "${redir_port}"
          ${iptables} -t nat -A BOX_LOCAL -m owner --uid-owner "$ACTUAL_UID" -j RETURN
        else
          log Debug "start_redirect: bypass_blacklist 解析异常或未安装应用: $ITEM"
        fi
      done
    fi
    if [ "${bypass_cn_ip}" = "true" ] && [ "${bypass_cn_ip_v4}" = "true" ] && command -v ipset >/dev/null 2>&1; then
      ${iptables} -t nat -A BOX_EXTERNAL -m set --match-set cnip dst -j RETURN
      ${iptables} -t nat -A BOX_LOCAL -m set --match-set cnip dst -j RETURN
    fi
    
    ${iptables} -t nat -A BOX_EXTERNAL -j LOCAL_IP_V4
    ${iptables} -t nat -A BOX_LOCAL -j LOCAL_IP_V4

    if [ "${ignore_ap_list}" != "" ]; then
      for ignore in "${ignore_ap_list[@]}"; do
        ${iptables} -t nat -A BOX_EXTERNAL -i "${ignore}" -j RETURN
      done
      [ ${network_mode} = "enhance" ] || log Info "${ignore_ap_list[*]} 入站接口已忽略透明代理。"
    fi

    ${iptables} -t nat -A BOX_EXTERNAL -p tcp -i lo -j REDIRECT --to-ports "${redir_port}"

    if [ "${ap_list}" != "" ]; then
      for ap in "${ap_list[@]}"; do
        ${iptables} -t nat -A BOX_EXTERNAL -p tcp -i "${ap}" -j REDIRECT --to-ports "${redir_port}"
      done
        [ ${network_mode} = "enhance" ] || log Info "${ap_list[*]} 透明代理。"
    fi

    ${iptables} -t nat -I PREROUTING -j BOX_EXTERNAL
    ${iptables} -t nat -I BOX_LOCAL -m owner --uid-owner "${box_user}" --gid-owner "${box_group}" -j RETURN
  fi

  if [ "${iptables}" = "$IPV" ]; then
    case "${proxy_mode}" in
      core)
        ${iptables} -t nat -A BOX_LOCAL -p tcp -j REDIRECT --to-ports "${redir_port}"
        [ ${network_mode} = "enhance" ] || log Info "核心模式：所有应用透明代理。"
        ;;
      blacklist|black)
        if [ -z "$(cat "${uid_list}")" ] ; then
          ${iptables} -t nat -A BOX_LOCAL -p tcp -j REDIRECT --to-ports "${redir_port}"
          [ ${network_mode} = "enhance" ] || log Info "所有应用透明代理。"
        else
          while read -r appid; do
            ${iptables} -t nat -A BOX_LOCAL -m owner --uid-owner "${appid}" -j RETURN
          done < "${uid_list}"
          ${iptables} -t nat -A BOX_LOCAL -p tcp -j REDIRECT --to-ports "${redir_port}"
          [ ${network_mode} = "enhance" ] || log Info "代理模式: ${proxy_mode} (${packages_list[*]}) 不透明代理。"
        fi

        if [ "${gid_list}" != "" ] ; then
          for gid in ${gid_list[@]} ; do
            ${iptables} -t nat -A BOX_LOCAL -m owner --gid-owner ${gid} -j RETURN
          done
          [ ${network_mode} = "enhance" ] || {
            [ "${iptables}" = "$IPV" ] &&  log Info "代理模式: ${proxy_mode}, GID (${gid_list[*]}) 不透明代理。"
          }
        fi
        ;;
      whitelist|white)
        if [ -z "$(cat "${uid_list}")" ] ; then
          ${iptables} -t nat -A BOX_LOCAL -p tcp -j REDIRECT --to-ports "${redir_port}"
          [ ${network_mode} = "enhance" ] || log Info "所有应用透明代理。"
        else
          while read -r appid; do
            ${iptables} -t nat -A BOX_LOCAL -p tcp -m owner --uid-owner "${appid}" -j REDIRECT --to-ports "${redir_port}"
          done < "${uid_list}"
          ${iptables} -t nat -A BOX_LOCAL -p tcp -m owner --uid-owner 0 -j REDIRECT --to-ports "${redir_port}"
          ${iptables} -t nat -A BOX_LOCAL -p tcp -m owner --uid-owner 1052 -j REDIRECT --to-ports "${redir_port}"
          [ ${network_mode} = "enhance" ] || log Info "代理模式: ${proxy_mode} (${packages_list[*]}) 透明代理。"
        fi

        if [ "${gid_list}" != "" ] ; then
          for gid in ${gid_list[@]} ; do
            ${iptables} -t nat -A BOX_LOCAL -p tcp -m owner --gid-owner ${gid} -j REDIRECT --to-ports ${redir_port}
          done
          [ ${network_mode} = "enhance" ] || [ "${iptables}" = "$IPV" ] && log Info "代理模式: ${proxy_mode}, GID (${gid_list[*]}) 透明代理。"
        fi
        ;;
      *)
        log Warning "代理模式: ${proxy_mode} 配置错误。"
        ${iptables} -t nat -A BOX_LOCAL -p tcp -j REDIRECT --to-ports "${redir_port}"
        [ ${network_mode} = "enhance" ] || log Info "所有应用透明代理。"
        ;;
    esac
  fi

  if [ "${iptables}" = "$IPV" ]; then
    ${iptables} -t nat -I OUTPUT -j BOX_LOCAL
  fi

  if [ "${iptables}" = "$IPV" ]; then
    ${iptables} -A OUTPUT -d 127.0.0.1 -p tcp -m owner --uid-owner "${box_user}" --gid-owner "${box_group}" -m tcp --dport "${redir_port}" -j REJECT
  else
    ${iptables} -A OUTPUT -d ::1 -p tcp -m owner --uid-owner "${box_user}" --gid-owner "${box_group}" -m tcp --dport "${redir_port}" -j REJECT
  fi
}

stop_redirect() {
  if [ "${iptables}" = "$IPV" ]; then
    ${iptables} -t nat -D PREROUTING -j BOX_EXTERNAL
    ${iptables} -t nat -D OUTPUT -j BOX_LOCAL
  fi

  if [ "${iptables}" = "$IPV" ]; then
    ${iptables} -D OUTPUT -d 127.0.0.1 -p tcp -m owner --uid-owner "${box_user}" --gid-owner "${box_group}" -m tcp --dport "${redir_port}" -j REJECT
    ${iptables} -D OUTPUT -d 127.0.0.1 -p tcp -m owner --uid-owner 0:3005 -m tcp --dport "${redir_port}" -j REJECT
  else
    ${iptables} -D OUTPUT -d ::1 -p tcp -m owner --uid-owner "${box_user}" --gid-owner "${box_group}" -m tcp --dport "${redir_port}" -j REJECT
    ${iptables} -D OUTPUT -d ::1 -p tcp -m owner --uid-owner 0:3005 -m tcp --dport "${redir_port}" -j REJECT
  fi

  if [ "${iptables}" = "$IPV" ]; then
    ${iptables} -t nat -F BOX_EXTERNAL
    ${iptables} -t nat -X BOX_EXTERNAL
    ${iptables} -t nat -F BOX_LOCAL
    ${iptables} -t nat -X BOX_LOCAL
    ${iptables} -t nat -F LOCAL_IP_V4
    ${iptables} -t nat -X LOCAL_IP_V4
    ${iptables} -t nat -D PREROUTING -j NAT_DNS_HIJACK 2>/dev/null || true
    ${iptables} -t nat -D OUTPUT -j NAT_DNS_HIJACK 2>/dev/null || true
    ${iptables} -t nat -F NAT_DNS_HIJACK 2>/dev/null || true
    ${iptables} -t nat -X NAT_DNS_HIJACK 2>/dev/null || true
    
    ${iptables} -t nat -F BOX_DNS_REDIRECT 2>/dev/null || true
    ${iptables} -t nat -X BOX_DNS_REDIRECT 2>/dev/null || true
  fi 
  
  if [ "${iptables}" = "$IP6V" ]; then
    ${iptables} -t nat -D PREROUTING -j NAT_DNS_HIJACK6 2>/dev/null || true
    ${iptables} -t nat -D OUTPUT -j NAT_DNS_HIJACK6 2>/dev/null || true
    ${iptables} -t nat -F NAT_DNS_HIJACK6 2>/dev/null || true
    ${iptables} -t nat -X NAT_DNS_HIJACK6 2>/dev/null || true
    
    ${iptables} -t nat -F BOX_DNS_REDIRECT6 2>/dev/null || true
    ${iptables} -t nat -X BOX_DNS_REDIRECT6 2>/dev/null || true
  fi
}

# ---------------------------------------------------------
# BYPASS_IP / BYPASS_IP6: 统一 bypass 链
# 职责：localnet ipset + CN IP ipset + addrtype LOCAL
# 与 box.tproxy (AndroidTProxyShell) 链名保持一致，
# 使 net.inotify 的动态 IP 追加能实时生效，解决断流问题。
# net.inotify 触发时只需 append 到此链，无需 renew 整个规则。
# ---------------------------------------------------------
setup_bypass_ip_chain() {
  if [ "${iptables}" = "$IPV" ]; then
    local chain="BYPASS_IP"
    ${iptables} -t mangle -N "${chain}" 2>/dev/null || true
    ${iptables} -t mangle -F "${chain}"

    ${iptables} -t mangle -A "${chain}" -m addrtype --dst-type LOCAL -p udp ! --dport 53 -j ACCEPT
    ${iptables} -t mangle -A "${chain}" -m addrtype --dst-type LOCAL ! -p udp -j ACCEPT

    if [ "${_localnet_ipset_ready}" = "1" ]; then
      ${iptables} -t mangle -A "${chain}" -m set --match-set localnet dst -p udp ! --dport 53 -j ACCEPT
      ${iptables} -t mangle -A "${chain}" -m set --match-set localnet dst ! -p udp -j ACCEPT
    else
      for subnet in "${intranet[@]}"; do
        ${iptables} -t mangle -A "${chain}" -d "${subnet}" -p udp ! --dport 53 -j ACCEPT
        ${iptables} -t mangle -A "${chain}" -d "${subnet}" ! -p udp -j ACCEPT
      done
    fi

    if [ "${bypass_cn_ip}" = "true" ] && [ "${bypass_cn_ip_v4}" = "true" ] && command -v ipset >/dev/null 2>&1; then
      ${iptables} -t mangle -A "${chain}" -m set --match-set cnip dst -p udp ! --dport 53 -j ACCEPT
      ${iptables} -t mangle -A "${chain}" -m set --match-set cnip dst ! -p udp -j ACCEPT
    fi
  else
    local chain="BYPASS_IP6"
    ${iptables} -t mangle -N "${chain}" 2>/dev/null || true
    ${iptables} -t mangle -F "${chain}"

    ${iptables} -t mangle -A "${chain}" -m addrtype --dst-type LOCAL -p udp ! --dport 53 -j ACCEPT
    ${iptables} -t mangle -A "${chain}" -m addrtype --dst-type LOCAL ! -p udp -j ACCEPT

    if [ "${_localnet6_ipset_ready}" = "1" ]; then
      ${iptables} -t mangle -A "${chain}" -m set --match-set localnet6 dst -p udp ! --dport 53 -j ACCEPT
      ${iptables} -t mangle -A "${chain}" -m set --match-set localnet6 dst ! -p udp -j ACCEPT
    else
      for subnet6 in "${intranet6[@]}"; do
        ${iptables} -t mangle -A "${chain}" -d "${subnet6}" -p udp ! --dport 53 -j ACCEPT
        ${iptables} -t mangle -A "${chain}" -d "${subnet6}" ! -p udp -j ACCEPT
      done
    fi

    if [ "${bypass_cn_ip}" = "true" ] && [ "${bypass_cn_ip_v6}" = "true" ] && command -v ipset >/dev/null 2>&1; then
      ${iptables} -t mangle -A "${chain}" -m set --match-set cnip6 dst -p udp ! --dport 53 -j ACCEPT
      ${iptables} -t mangle -A "${chain}" -m set --match-set cnip6 dst ! -p udp -j ACCEPT
    fi
  fi
}

start_tproxy() {
  if [ "${iptables}" = "$IPV" ]; then
    ip rule add fwmark "${fwmark}" table "${table}" pref "${pref}"
    ip route add local default dev lo table "${table}"
  else
    ip -6 rule add fwmark "${fwmark}" table "${table}" pref "${pref}"
    ip -6 route add local default dev lo table "${table}"
  fi

  # ---------------------------------------------------------
  # 1. DIVERT: 优化的 Socket 分流链
  # 将已建立透明代理的 socket 直接放行，极大降低系统开销
  # ---------------------------------------------------------
  ${iptables} -t mangle -N BOX_DIVERT 2>/dev/null || true
  ${iptables} -t mangle -F BOX_DIVERT
  ${iptables} -t mangle -A BOX_DIVERT -j MARK --set-xmark "${fwmark}"
  ${iptables} -t mangle -A BOX_DIVERT -j ACCEPT

  # ---------------------------------------------------------
  # 2. BOX_MAC: 独立的 MAC 地址匹配链
  # 使用 macs_list（由 app 或 settings.ini 提供），含格式校验
  # ---------------------------------------------------------
  ${iptables} -t mangle -N BOX_MAC 2>/dev/null || true
  ${iptables} -t mangle -F BOX_MAC
  if [ "${mac_filter}" = "true" ]; then
    if [[ "${mac_mode}" == @(blacklist|black) ]]; then
      for mac_item in "${macs_list[@]}"; do
        local mac
        mac="$(echo "${mac_item}" | busybox tr '[:upper:]' '[:lower:]' | busybox tr -d '[:space:]')"
        echo "${mac}" | busybox grep -Eq '^[0-9a-f]{2}(:[0-9a-f]{2}){5}$' || continue
        ${iptables} -t mangle -A BOX_MAC -m mac --mac-source "${mac}" -j RETURN
      done
      ${iptables} -t mangle -A BOX_MAC -j MARK --set-xmark "${fwmark}"
      [ "${iptables}" = "$IPV" ] && log Info "MAC 黑名单生效，已排除 (${macs_list[*]})。"
    elif [[ "${mac_mode}" == @(whitelist|white) ]]; then
      local _mac_added="false"
      for mac_item in "${macs_list[@]}"; do
        local mac
        mac="$(echo "${mac_item}" | busybox tr '[:upper:]' '[:lower:]' | busybox tr -d '[:space:]')"
        echo "${mac}" | busybox grep -Eq '^[0-9a-f]{2}(:[0-9a-f]{2}){5}$' || continue
        ${iptables} -t mangle -A BOX_MAC -m mac --mac-source "${mac}" -j MARK --set-xmark "${fwmark}"
        _mac_added="true"
      done
      if [ "${_mac_added}" != "true" ]; then
        [ "${iptables}" = "$IPV" ] && log Warning "热点接口：MAC 白名单已启用但列表为空/无有效项，将不代理热点客户端流量"
      fi
      ${iptables} -t mangle -A BOX_MAC -j RETURN
      [ "${iptables}" = "$IPV" ] && log Info "MAC 白名单生效，仅代理 (${macs_list[*]})。"
    fi
  else
    ${iptables} -t mangle -A BOX_MAC -j MARK --set-xmark "${fwmark}"
  fi

  # ---------------------------------------------------------
  # 3. BYPASS_IP / BYPASS_IP6: 统一 bypass 链（net.inotify 兼容）
  # ---------------------------------------------------------
  setup_bypass_ip_chain

  # ---------------------------------------------------------
  # 4. BOX_EXTERNAL: PREROUTING 主链 (入站代理)
  # 引入了 Conntrack 性能优化机制
  # ---------------------------------------------------------
  ${iptables} -t mangle -N BOX_EXTERNAL 2>/dev/null || true
  ${iptables} -t mangle -F BOX_EXTERNAL

  ${iptables} -t mangle -I BOX_EXTERNAL -i rmnet_data+ -j RETURN

  ${iptables} -t mangle -A BOX_EXTERNAL -m conntrack --ctdir REPLY -j RETURN

  [ ${network_mode} = "enhance" ] || ${iptables} -t mangle -A BOX_EXTERNAL -p tcp -m connmark --mark "${fwmark}" -j TPROXY --on-port "${tproxy_port}" --tproxy-mark "${fwmark}"
  ${iptables} -t mangle -A BOX_EXTERNAL -p udp -m connmark --mark "${fwmark}" -j TPROXY --on-port "${tproxy_port}" --tproxy-mark "${fwmark}"

  ${iptables} -t mangle -N BOX_EXT_NEW 2>/dev/null || true
  ${iptables} -t mangle -F BOX_EXT_NEW
  
  [ ${network_mode} = "enhance" ] || ${iptables} -t mangle -A BOX_EXTERNAL -p tcp --syn -j BOX_EXT_NEW
  ${iptables} -t mangle -A BOX_EXTERNAL -p udp -m conntrack --ctstate NEW,RELATED -j BOX_EXT_NEW

  ${iptables} -t mangle -A BOX_EXTERNAL -m mark --mark "${fwmark}" -j CONNMARK --save-mark
  [ ${network_mode} = "enhance" ] || ${iptables} -t mangle -A BOX_EXTERNAL -p tcp -m mark --mark "${fwmark}" -j TPROXY --on-port "${tproxy_port}" --tproxy-mark "${fwmark}"
  ${iptables} -t mangle -A BOX_EXTERNAL -p udp -m mark --mark "${fwmark}" -j TPROXY --on-port "${tproxy_port}" --tproxy-mark "${fwmark}"

  ${iptables} -t mangle -I PREROUTING -j BOX_EXTERNAL
  
  [ ${network_mode} = "enhance" ] || ${iptables} -t mangle -I PREROUTING -p tcp -m socket --transparent -j BOX_DIVERT

  # ---------------------------------------------------------
  # 4. BOX_EXT_NEW: 入站新连接评估子链
  # ---------------------------------------------------------
  # DNS 劫持放行逻辑
  if [ "${dns_hijack_mode}" = "redirect" ] || [ "${dns_hijack_mode}" = "disable" ] || ([ "${mihomo_dns_forward}" = "enable" ] && [[ "${bin_name}" == @(mihomo|hysteria) ]]); then
    ${iptables} -t mangle -A BOX_EXT_NEW -p udp --dport 53 -j RETURN
    [ ${network_mode} = "enhance" ] || ${iptables} -t mangle -A BOX_EXT_NEW -p tcp --dport 53 -j RETURN
  else
    ${iptables} -t mangle -A BOX_EXT_NEW -p udp --dport 53 -j MARK --set-xmark "${fwmark}"
    [ ${network_mode} = "enhance" ] || ${iptables} -t mangle -A BOX_EXT_NEW -p tcp --dport 53 -j MARK --set-xmark "${fwmark}"
    ${iptables} -t mangle -A BOX_EXT_NEW -p udp --dport 53 -j RETURN
    [ ${network_mode} = "enhance" ] || ${iptables} -t mangle -A BOX_EXT_NEW -p tcp --dport 53 -j RETURN
  fi

  if [ "${ignore_ap_list}" != "" ]; then
    for ignore in ${ignore_ap_list[@]} ; do
      ${iptables} -t mangle -A BOX_EXT_NEW -i "${ignore}" -j RETURN
    done
  fi

  if [ "${iptables}" = "$IP6V" ]; then
    if [ -n "${fake_ip6_range}" ] && [ "${bin_name}" = "mihomo" ]; then
      ${iptables} -t mangle -A BOX_EXT_NEW -d "${fake_ip6_range}" -j MARK --set-xmark "${fwmark}"
    fi
    ${iptables} -t mangle -A BOX_EXT_NEW -j BYPASS_IP6
  else
    ${iptables} -t mangle -A BOX_EXT_NEW -j BYPASS_IP
  fi
  
  ${iptables} -t mangle -A BOX_EXT_NEW -i lo -j MARK --set-xmark "${fwmark}"

  if [ "${ap_list}" != "" ]; then
    for ap in ${ap_list[@]} ; do
      ${iptables} -t mangle -A BOX_EXT_NEW -i "${ap}" -j BOX_MAC
    done
  fi

  # ---------------------------------------------------------
  # 5. BOX_LOCAL: OUTPUT 主链 (本地出站代理)
  # ---------------------------------------------------------
  ${iptables} -t mangle -N BOX_LOCAL 2>/dev/null || true
  ${iptables} -t mangle -F BOX_LOCAL

  ${iptables} -t mangle -A BOX_LOCAL -m owner --uid-owner ${box_user} --gid-owner ${box_group} -j RETURN
  
  ${iptables} -t mangle -A BOX_LOCAL -m owner --gid-owner 3004 -j RETURN
  
  ${iptables} -t mangle -A BOX_LOCAL -m conntrack --ctdir REPLY -j RETURN

  [ ${network_mode} = "enhance" ] || ${iptables} -t mangle -A BOX_LOCAL -p tcp -m connmark --mark "${fwmark}" -j MARK --set-xmark "${fwmark}"
  ${iptables} -t mangle -A BOX_LOCAL -p udp -m connmark --mark "${fwmark}" -j MARK --set-xmark "${fwmark}"

  ${iptables} -t mangle -N BOX_LOC_NEW 2>/dev/null || true
  ${iptables} -t mangle -F BOX_LOC_NEW

  [ ${network_mode} = "enhance" ] || ${iptables} -t mangle -A BOX_LOCAL -p tcp --syn -j BOX_LOC_NEW
  ${iptables} -t mangle -A BOX_LOCAL -p udp -m conntrack --ctstate NEW,RELATED -j BOX_LOC_NEW

  ${iptables} -t mangle -A BOX_LOCAL -m mark --mark "${fwmark}" -j CONNMARK --save-mark

  ${iptables} -t mangle -I OUTPUT -j BOX_LOCAL

  # ---------------------------------------------------------
  # 6. BOX_LOC_PROXY: 代理目标流量子链（DNS / 内网 / CN IP / MARK）
  # 所有确定需要代理的包统一进此链处理，不再混入 UID 判断逻辑
  # ---------------------------------------------------------
  ${iptables} -t mangle -N BOX_LOC_PROXY 2>/dev/null || true
  ${iptables} -t mangle -F BOX_LOC_PROXY

  if [ "${dns_hijack_mode}" = "redirect" ] || [ "${dns_hijack_mode}" = "disable" ] || ([ "${mihomo_dns_forward}" = "enable" ] && [[ "${bin_name}" == @(mihomo|hysteria) ]]); then
    ${iptables} -t mangle -A BOX_LOC_PROXY -p udp --dport 53 -j RETURN
    [ ${network_mode} = "enhance" ] || ${iptables} -t mangle -A BOX_LOC_PROXY -p tcp --dport 53 -j RETURN
  else
    ${iptables} -t mangle -A BOX_LOC_PROXY -p udp --dport 53 -j MARK --set-xmark "${fwmark}"
    [ ${network_mode} = "enhance" ] || ${iptables} -t mangle -A BOX_LOC_PROXY -p tcp --dport 53 -j MARK --set-xmark "${fwmark}"
    ${iptables} -t mangle -A BOX_LOC_PROXY -p udp --dport 53 -j RETURN
    [ ${network_mode} = "enhance" ] || ${iptables} -t mangle -A BOX_LOC_PROXY -p tcp --dport 53 -j RETURN
  fi

  if [ "${iptables}" = "$IP6V" ]; then
    if [ -n "${fake_ip6_range}" ] && [ "${bin_name}" = "mihomo" ]; then
      ${iptables} -t mangle -A BOX_LOC_PROXY -d "${fake_ip6_range}" -j MARK --set-xmark "${fwmark}"
    fi
    ${iptables} -t mangle -A BOX_LOC_PROXY -j BYPASS_IP6
  else
    ${iptables} -t mangle -A BOX_LOC_PROXY -j BYPASS_IP
  fi

  ${iptables} -t mangle -A BOX_LOC_PROXY -j MARK --set-xmark "${fwmark}"

  # ---------------------------------------------------------
  # 7. BOX_LOC_NEW: UID / GID 判断子链
  # 先判断身份，直连的 RETURN，代理的 jump BOX_LOC_PROXY
  # DNS / 内网 / CN IP 规则对直连 UID 完全透明
  # ---------------------------------------------------------

  # bypass_blacklist：强制代理  
  if [ -n "${bypass_blacklist}" ]; then
    for ITEM in ${bypass_blacklist}; do
      if [ "${ITEM#*:}" != "${ITEM}" ]; then
        USER_ID="${ITEM%%:*}"
        PKG="${ITEM#*:}"
      else
        USER_ID=0
        PKG="${ITEM}"
      fi
      BASE_UID=$(awk -v pkg="${PKG}" '$1 == pkg {print $2; exit}' /data/system/packages.list 2>/dev/null)
      if [ -n "${BASE_UID}" ] && [ -n "${USER_ID}" ] && \
         [ -z "${USER_ID//[0-9]/}" ] && [ -z "${BASE_UID//[0-9]/}" ]; then
        ACTUAL_UID=$((USER_ID * 100000 + BASE_UID))
        ${iptables} -t mangle -A BOX_LOC_NEW -m owner --uid-owner "${ACTUAL_UID}" -j MARK --set-xmark "${fwmark}"
        ${iptables} -t mangle -A BOX_LOC_NEW -m owner --uid-owner "${ACTUAL_UID}" -j RETURN
      else
        log Debug "BOX_LOC_NEW: bypass_blacklist 解析异常或未安装应用: ${ITEM}"
      fi
    done
  fi

  case "${proxy_mode}" in
    core)
      ${iptables} -t mangle -A BOX_LOC_NEW -j BOX_LOC_PROXY
      ;;
    blacklist|black)
      if [ "${gid_list}" != "" ] ; then
        for gid in ${gid_list[@]} ; do
          ${iptables} -t mangle -A BOX_LOC_NEW -m owner --gid-owner ${gid} -j RETURN
        done
      fi
      if [ -z "$(cat "${uid_list}")" ] ; then
        ${iptables} -t mangle -A BOX_LOC_NEW -j BOX_LOC_PROXY
      else
        while read -r appid; do
          ${iptables} -t mangle -A BOX_LOC_NEW -m owner --uid-owner "${appid}" -j RETURN
        done < "${uid_list}"
        ${iptables} -t mangle -A BOX_LOC_NEW -j BOX_LOC_PROXY
      fi
      ;;
    whitelist|white)
      if [ -z "$(cat "${uid_list}")" ] ; then
        ${iptables} -t mangle -A BOX_LOC_NEW -j BOX_LOC_PROXY
      else
        while read -r appid; do
          ${iptables} -t mangle -A BOX_LOC_NEW -m owner --uid-owner "${appid}" -j BOX_LOC_PROXY
        done < "${uid_list}"
        ${iptables} -t mangle -A BOX_LOC_NEW -m owner --uid-owner 0 -j BOX_LOC_PROXY
        ${iptables} -t mangle -A BOX_LOC_NEW -m owner --uid-owner 1052 -j BOX_LOC_PROXY
      fi
      if [ "${gid_list}" != "" ] ; then
        for gid in ${gid_list[@]} ; do
          ${iptables} -t mangle -A BOX_LOC_NEW -m owner --gid-owner ${gid} -j BOX_LOC_PROXY
        done
      fi
      ${iptables} -t mangle -A BOX_LOC_NEW -j RETURN
      ;;
    *)
      ${iptables} -t mangle -A BOX_LOC_NEW -j BOX_LOC_PROXY
      ;;
  esac

  # ---------------------------------------------------------
  # 补充特性的收尾处理 (NAT表, QUIC, ICMP) 与原来完全保持一致
  # ---------------------------------------------------------
  if [ "${iptables}" = "$IPV" ] && [ "${dns_hijack_mode}" = "redirect" ]; then
    local _dns_port="${mihomo_dns_port:-1053}"
    ${iptables} -t nat -N NAT_DNS_HIJACK 2>/dev/null || true
    ${iptables} -t nat -F NAT_DNS_HIJACK
    ${iptables} -t nat -A NAT_DNS_HIJACK -m owner --uid-owner "${box_user}" --gid-owner "${box_group}" -j RETURN
    ${iptables} -t nat -A NAT_DNS_HIJACK -m owner --gid-owner 3004 -j RETURN
    if [ "${ignore_ap_list}" != "" ]; then
      for ignore in ${ignore_ap_list[@]} ; do
        ${iptables} -t nat -A NAT_DNS_HIJACK -i "${ignore}" -j RETURN
      done
    fi
    ${iptables} -t nat -N BOX_DNS_REDIRECT 2>/dev/null || true
    ${iptables} -t nat -F BOX_DNS_REDIRECT
    ${iptables} -t nat -A BOX_DNS_REDIRECT -p tcp --dport 53 -j REDIRECT --to-ports "${_dns_port}"
    ${iptables} -t nat -A BOX_DNS_REDIRECT -p udp --dport 53 -j REDIRECT --to-ports "${_dns_port}"
    apply_nat_dns_bypass "NAT_DNS_HIJACK" "BOX_DNS_REDIRECT"
    ${iptables} -t nat -I PREROUTING -j NAT_DNS_HIJACK
    ${iptables} -t nat -I OUTPUT -j NAT_DNS_HIJACK
  fi

  if [ "${iptables}" = "$IP6V" ] && [ "${dns_hijack_mode}" = "redirect" ] && ip6_nat_supported; then
    local _dns_port6="${mihomo_dns_port:-1053}"
    ${iptables} -t nat -N NAT_DNS_HIJACK6 2>/dev/null || true
    ${iptables} -t nat -F NAT_DNS_HIJACK6
    ${iptables} -t nat -A NAT_DNS_HIJACK6 -m owner --uid-owner "${box_user}" --gid-owner "${box_group}" -j RETURN
    ${iptables} -t nat -A NAT_DNS_HIJACK6 -m owner --gid-owner 3004 -j RETURN
    ${iptables} -t nat -N BOX_DNS_REDIRECT6 2>/dev/null || true
    ${iptables} -t nat -F BOX_DNS_REDIRECT6
    ${iptables} -t nat -A BOX_DNS_REDIRECT6 -p tcp --dport 53 -j REDIRECT --to-ports "${_dns_port6}"
    ${iptables} -t nat -A BOX_DNS_REDIRECT6 -p udp --dport 53 -j REDIRECT --to-ports "${_dns_port6}"
    apply_nat_dns_bypass "NAT_DNS_HIJACK6" "BOX_DNS_REDIRECT6"
    ${iptables} -t nat -I PREROUTING -j NAT_DNS_HIJACK6
    ${iptables} -t nat -I OUTPUT -j NAT_DNS_HIJACK6
  fi
  
  if [ ${network_mode} != "enhance" ]; then
    if [ "${iptables}" = "$IPV" ]; then
      ${iptables} -A OUTPUT -d 127.0.0.1 -p tcp -m owner --uid-owner "${box_user}" --gid-owner "${box_group}" -m tcp --dport "${tproxy_port}" -j REJECT
    else
      ${iptables} -A OUTPUT -d ::1 -p tcp -m owner --uid-owner "${box_user}" --gid-owner "${box_group}" -m tcp --dport "${tproxy_port}" -j REJECT
    fi
  fi
  
  if [ "${iptables}" = "$IPV" ] && [ "${dns_hijack_mode}" != "redirect" ] && [ "${mihomo_dns_forward}" = "enable" ] && [ "${bin_name}" = "mihomo" ]; then
    ${iptables} -t nat -N MIHOMO_DNS_EXTERNAL 2>/dev/null || true
    ${iptables} -t nat -F MIHOMO_DNS_EXTERNAL
    ${iptables} -t nat -A MIHOMO_DNS_EXTERNAL -p udp --dport 53 -j REDIRECT --to-ports "${mihomo_dns_port:-1053}"
    ${iptables} -t nat -I PREROUTING -j MIHOMO_DNS_EXTERNAL

    ${iptables} -t nat -N MIHOMO_DNS_LOCAL 2>/dev/null || true
    ${iptables} -t nat -F MIHOMO_DNS_LOCAL
    ${iptables} -t nat -A MIHOMO_DNS_LOCAL -m owner --uid-owner "${box_user}" --gid-owner "${box_group}" -j RETURN
    ${iptables} -t nat -N BOX_DNS_REDIRECT 2>/dev/null || true
    ${iptables} -t nat -F BOX_DNS_REDIRECT
    ${iptables} -t nat -A BOX_DNS_REDIRECT -p udp --dport 53 -j REDIRECT --to-ports "${mihomo_dns_port:-1053}"
    apply_nat_dns_bypass "MIHOMO_DNS_LOCAL" "BOX_DNS_REDIRECT"
    ${iptables} -t nat -I OUTPUT -j MIHOMO_DNS_LOCAL
  fi

  if [ "${iptables}" = "$IPV" ] && [[ "${bin_name}" == @(mihomo|sing-box) ]]; then
    if [ -n "${fake_ip_range}" ]; then
      ${iptables} -t nat -I OUTPUT -d "${fake_ip_range}" -p icmp -j DNAT --to-destination 127.0.0.1
      ${iptables} -t nat -I PREROUTING -d "${fake_ip_range}" -p icmp -j DNAT --to-destination 127.0.0.1
    fi
  fi
}

stop_tproxy() {
  if [ "${iptables}" = "$IPV" ]; then    
    ip rule del fwmark "${fwmark}" table "${table}" pref "${pref}" 2>/dev/null || true
    ip route del local default dev lo table "${table}" 2>/dev/null || true
    ip route flush table "${table}" 2>/dev/null || true
  else
    ip -6 rule del fwmark "${fwmark}" table "${table}" pref "${pref}" 2>/dev/null || true
    ip -6 route del local default dev lo table "${table}" 2>/dev/null || true
    ip -6 route flush table "${table}" 2>/dev/null || true
  fi

  ${iptables} -t mangle -D PREROUTING -j BOX_EXTERNAL 2>/dev/null || true
  ${iptables} -t mangle -D OUTPUT -j BOX_LOCAL 2>/dev/null || true
  [ ${network_mode} = "enhance" ] || ${iptables} -t mangle -D PREROUTING -p tcp -m socket --transparent -j BOX_DIVERT 2>/dev/null || true

  for chain in BOX_EXTERNAL BOX_EXT_NEW BOX_LOCAL BOX_LOC_NEW BOX_LOC_PROXY BOX_MAC BOX_DIVERT BYPASS_IP BYPASS_IP6; do
    ${iptables} -t mangle -F ${chain} 2>/dev/null || true
    ${iptables} -t mangle -X ${chain} 2>/dev/null || true
  done

  block_quic disable

  if [ "${iptables}" = "$IPV" ]; then
    ${iptables} -D OUTPUT -d 127.0.0.1 -p tcp -m owner --uid-owner "${box_user}" --gid-owner "${box_group}" -m tcp --dport "${tproxy_port}" -j REJECT 2>/dev/null || true
    ${iptables} -D OUTPUT -d 127.0.0.1 -p tcp -m owner --uid-owner 0:3005 -m tcp --dport "${tproxy_port}" -j REJECT 2>/dev/null || true
  else
    ${iptables} -D OUTPUT -d ::1 -p tcp -m owner --uid-owner "${box_user}" --gid-owner "${box_group}" -m tcp --dport "${tproxy_port}" -j REJECT 2>/dev/null || true
    ${iptables} -D OUTPUT -d ::1 -p tcp -m owner --uid-owner 0:3005 -m tcp --dport "${tproxy_port}" -j REJECT 2>/dev/null || true
  fi

  if [ "${iptables}" = "$IPV" ]; then
    ${iptables} -t nat -D PREROUTING -j MIHOMO_DNS_EXTERNAL 2>/dev/null || true
    ${iptables} -t nat -D OUTPUT -j MIHOMO_DNS_LOCAL 2>/dev/null || true
    ${iptables} -t nat -F MIHOMO_DNS_EXTERNAL 2>/dev/null || true
    ${iptables} -t nat -X MIHOMO_DNS_EXTERNAL 2>/dev/null || true
    ${iptables} -t nat -F MIHOMO_DNS_LOCAL 2>/dev/null || true
    ${iptables} -t nat -X MIHOMO_DNS_LOCAL 2>/dev/null || true

    ${iptables} -t nat -D PREROUTING -j NAT_DNS_HIJACK 2>/dev/null || true
    ${iptables} -t nat -D OUTPUT -j NAT_DNS_HIJACK 2>/dev/null || true
    ${iptables} -t nat -F NAT_DNS_HIJACK 2>/dev/null || true
    ${iptables} -t nat -X NAT_DNS_HIJACK 2>/dev/null || true

    ${iptables} -t nat -F BOX_DNS_REDIRECT 2>/dev/null || true
    ${iptables} -t nat -X BOX_DNS_REDIRECT 2>/dev/null || true

    if [ -n "${fake_ip_range}" ]; then
      ${iptables} -t nat -D OUTPUT -p icmp -d "${fake_ip_range}" -j DNAT --to-destination 127.0.0.1 2>/dev/null || true
      ${iptables} -t nat -D PREROUTING -p icmp -d "${fake_ip_range}" -j DNAT --to-destination 127.0.0.1 2>/dev/null || true
      ${iptables} -t nat -D OUTPUT -d "${fake_ip_range}" -p icmp -j DNAT --to-destination 127.0.0.1 2>/dev/null || true
      ${iptables} -t nat -D PREROUTING -d "${fake_ip_range}" -p icmp -j DNAT --to-destination 127.0.0.1 2>/dev/null || true
    fi
  fi
  if [ "${iptables}" = "$IP6V" ]; then
    ${iptables} -t nat -D PREROUTING -j NAT_DNS_HIJACK6 2>/dev/null || true
    ${iptables} -t nat -D OUTPUT -j NAT_DNS_HIJACK6 2>/dev/null || true
    ${iptables} -t nat -F NAT_DNS_HIJACK6 2>/dev/null || true
    ${iptables} -t nat -X NAT_DNS_HIJACK6 2>/dev/null || true

    ${iptables} -t nat -F BOX_DNS_REDIRECT6 2>/dev/null || true
    ${iptables} -t nat -X BOX_DNS_REDIRECT6 2>/dev/null || true
  fi
}

start_tun_bypass() {
  local pref="9000"

  local tun_mtu
  case "${bin_name}" in
    sing-box)
      tun_mtu=$(busybox awk '
        /"type"[[:space:]]*:[[:space:]]*"tun"/ { in_tun=1 }
        in_tun && /"mtu"[[:space:]]*:/ {
          gsub(/[^0-9]/, "", $0)
          if ($0+0 > 0) { print $0+0; exit }
        }
        /"type"[[:space:]]*:[[:space:]]*"/ && in_tun { in_tun=0 }
      ' "${sing_config}" 2>/dev/null)
      ;;
    mihomo)
      tun_mtu=$(busybox awk '
        /^tun:/ { in_tun=1 }
        in_tun && /^[^ ]/ && !/^tun:/ { in_tun=0 }
        in_tun && /^[[:space:]]*mtu:/ { gsub(/[^0-9]/, "", $2); print $2+0; exit }
      ' "${mihomo_config}" 2>/dev/null)
      ;;
  esac
  tun_mtu=${tun_mtu:-1400}
  [ "${tun_mtu}" -gt 0 ] 2>/dev/null || tun_mtu=1400

  ip link set dev "$tun_device" mtu "${tun_mtu}"
  sysctl -w net.ipv4.conf.all.rp_filter=0 >/dev/null 2>&1
  sysctl -w net.ipv4.conf.default.rp_filter=0 >/dev/null 2>&1
  sysctl -w net.ipv4.conf."$tun_device".rp_filter=0 >/dev/null 2>&1

  if [ "${iptables}" = "$IPV" ]; then
    ip -4 route replace default dev "$tun_device" table "$table" 2>/dev/null
    ip -4 rule del pref "$pref" 2>/dev/null || true
    ip -4 rule del fwmark "${fwmark%%/*}" lookup "$table" 2>/dev/null || true
    if ! ip -4 rule add fwmark "$fwmark" lookup "$table" pref "$pref" 2>/dev/null; then
      log Warning "IPv4 ip rule add 失败，重建中"
      ip -4 rule del pref "$pref" 2>/dev/null || true
      ip -4 rule add fwmark "$fwmark" lookup "$table" pref "$pref" 2>/dev/null ||         log Error "IPv4 ip rule add fwmark $fwmark lookup $table pref $pref 失败"
    fi
  else
    ip -6 route replace default dev "$tun_device" table "$table" 2>/dev/null
    ip -6 rule del pref "$pref" 2>/dev/null || true
    ip -6 rule del fwmark "${fwmark%%/*}" lookup "$table" 2>/dev/null || true
    if ! ip -6 rule add fwmark "$fwmark" lookup "$table" pref "$pref" 2>/dev/null; then
      log Warning "IPv6 ip rule add 失败，重建中"
      ip -6 rule del pref "$pref" 2>/dev/null || true
      ip -6 rule add fwmark "$fwmark" lookup "$table" pref "$pref" 2>/dev/null ||         log Error "IPv6 ip rule add fwmark $fwmark lookup $table pref $pref 失败"
    fi
  fi

  ${iptables} -t mangle -N TUN_OUTPUT 2>/dev/null || true
  ${iptables} -t mangle -F TUN_OUTPUT

  ${iptables} -t mangle -A TUN_OUTPUT -m conntrack --ctdir REPLY -j RETURN

  ${iptables} -t mangle -A TUN_OUTPUT -m owner --uid-owner "${box_user}" -j RETURN

  ${iptables} -t mangle -A TUN_OUTPUT -m owner --gid-owner 3004 -j RETURN

  ${iptables} -t mangle -A TUN_OUTPUT -d 127.0.0.1 -j RETURN

  if [ "${_localnet_ipset_ready}" = "1" ]; then
    if [ "${iptables}" = "$IPV" ]; then
      ${iptables} -t mangle -A TUN_OUTPUT -m set --match-set localnet dst -j RETURN
    else
      ${iptables} -t mangle -A TUN_OUTPUT -m set --match-set localnet6 dst -j RETURN
    fi
  fi

  if [ -n "$bypass_blacklist" ]; then
    for ITEM in $bypass_blacklist; do
      USER_ID=0; PKG="$ITEM"
      [[ "$ITEM" == *:* ]] && USER_ID="${ITEM%%:*}" && PKG="${ITEM#*:}"
      _UID=$(awk -v pkg="$PKG" '$1 == pkg {print $2; exit}' /data/system/packages.list 2>/dev/null)
      if [ -n "$_UID" ]; then
        ACTUAL_UID=$((USER_ID * 100000 + _UID))
        ${iptables} -t mangle -A TUN_OUTPUT -m owner --uid-owner "$ACTUAL_UID" -j MARK --set-mark "$fwmark"
        ${iptables} -t mangle -A TUN_OUTPUT -m owner --uid-owner "$ACTUAL_UID" -j CONNMARK --save-mark
        ${iptables} -t mangle -A TUN_OUTPUT -m owner --uid-owner "$ACTUAL_UID" -j RETURN
      fi
    done
  fi

  if [ "${bypass_cn_ip}" = "true" ] && command -v ipset >/dev/null 2>&1; then
    if [ "${iptables}" = "$IPV" ] && [ "${bypass_cn_ip_v4}" = "true" ]; then
      ${iptables} -t mangle -A TUN_OUTPUT -p udp --dport 53 -m set --match-set cnip dst -j MARK --set-mark "$fwmark"
      ${iptables} -t mangle -A TUN_OUTPUT -p tcp --dport 53 -m set --match-set cnip dst -j MARK --set-mark "$fwmark"
      ${iptables} -t mangle -A TUN_OUTPUT -m set --match-set cnip dst -j RETURN
    elif [ "${iptables}" = "$IP6V" ] && [ "${bypass_cn_ip_v6}" = "true" ]; then
      ${iptables} -t mangle -A TUN_OUTPUT -p udp --dport 53 -m set --match-set cnip6 dst -j MARK --set-mark "$fwmark"
      ${iptables} -t mangle -A TUN_OUTPUT -p tcp --dport 53 -m set --match-set cnip6 dst -j MARK --set-mark "$fwmark"
      ${iptables} -t mangle -A TUN_OUTPUT -m set --match-set cnip6 dst -j RETURN
    fi
  fi

  ${iptables} -t mangle -A TUN_OUTPUT -m connmark --mark "$fwmark" -j MARK --set-mark "$fwmark"
  ${iptables} -t mangle -A TUN_OUTPUT -m mark --mark "$fwmark" -j RETURN

  ${iptables} -t mangle -A TUN_OUTPUT -j MARK --set-mark "$fwmark"
  ${iptables} -t mangle -A TUN_OUTPUT -j CONNMARK --save-mark

  ${iptables} -t mangle -I OUTPUT -j TUN_OUTPUT
  ${iptables} -t mangle -N TUN_EXTERNAL 2>/dev/null || true
  ${iptables} -t mangle -F TUN_EXTERNAL

  ${iptables} -t mangle -A TUN_EXTERNAL -i rmnet_data+ -j RETURN
  ${iptables} -t mangle -A TUN_EXTERNAL -i wlan0 -j RETURN

  ${iptables} -t mangle -A TUN_EXTERNAL -m conntrack --ctdir REPLY -j RETURN

  ${iptables} -t mangle -A TUN_EXTERNAL -m connmark --mark "$fwmark" -j MARK --set-mark "$fwmark"
  ${iptables} -t mangle -A TUN_EXTERNAL -m mark --mark "$fwmark" -j RETURN

  if [ "${_localnet_ipset_ready}" = "1" ]; then
    if [ "${iptables}" = "$IPV" ]; then
      ${iptables} -t mangle -A TUN_EXTERNAL -m set --match-set localnet dst -j RETURN
    else
      ${iptables} -t mangle -A TUN_EXTERNAL -m set --match-set localnet6 dst -j RETURN
    fi
  fi

  if [ "${bypass_cn_ip}" = "true" ] && command -v ipset >/dev/null 2>&1; then
    if [ "${iptables}" = "$IPV" ] && [ "${bypass_cn_ip_v4}" = "true" ]; then
      ${iptables} -t mangle -A TUN_EXTERNAL -p udp --dport 53 -m set --match-set cnip dst -j MARK --set-mark "$fwmark"
      ${iptables} -t mangle -A TUN_EXTERNAL -p tcp --dport 53 -m set --match-set cnip dst -j MARK --set-mark "$fwmark"
      ${iptables} -t mangle -A TUN_EXTERNAL -m set --match-set cnip dst -j RETURN
    elif [ "${iptables}" = "$IP6V" ] && [ "${bypass_cn_ip_v6}" = "true" ]; then
      ${iptables} -t mangle -A TUN_EXTERNAL -p udp --dport 53 -m set --match-set cnip6 dst -j MARK --set-mark "$fwmark"
      ${iptables} -t mangle -A TUN_EXTERNAL -p tcp --dport 53 -m set --match-set cnip6 dst -j MARK --set-mark "$fwmark"
      ${iptables} -t mangle -A TUN_EXTERNAL -m set --match-set cnip6 dst -j RETURN
    fi
  fi

  ${iptables} -t mangle -A TUN_EXTERNAL -i lo -j MARK --set-mark "$fwmark"
  if [ "${ap_list}" != "" ]; then
    for ap in ${ap_list[@]}; do
      ${iptables} -t mangle -A TUN_EXTERNAL -i "${ap}" -j MARK --set-mark "$fwmark"
    done
  fi

  ${iptables} -t mangle -A TUN_EXTERNAL -m mark --mark "$fwmark" -j CONNMARK --save-mark

  ${iptables} -t mangle -I PREROUTING -j TUN_EXTERNAL
}

stop_tun_bypass() {
  local pref="9000"

  if [ "${iptables}" = "$IPV" ]; then    
    ip -4 rule del fwmark "${fwmark}" lookup "${table}" pref "$pref" 2>/dev/null || true
    ip -4 route flush table "$table" 2>/dev/null || true
  else
    ip -6 rule del fwmark "${fwmark}" lookup "${table}" pref "$pref" 2>/dev/null || true
    ip -6 rule del oif "$tun_device" lookup "$table" 2>/dev/null || true
    ip -6 route flush table "$table" 2>/dev/null || true
  fi

  ${iptables} -t mangle -D OUTPUT -j TUN_OUTPUT 2>/dev/null || true
  ${iptables} -t mangle -F TUN_OUTPUT 2>/dev/null || true
  ${iptables} -t mangle -X TUN_OUTPUT 2>/dev/null || true
  ${iptables} -t mangle -D PREROUTING -j TUN_EXTERNAL 2>/dev/null || true
  ${iptables} -t mangle -F TUN_EXTERNAL 2>/dev/null || true
  ${iptables} -t mangle -X TUN_EXTERNAL 2>/dev/null || true
}

cleanup_iptables() {
  for iptables in "$IPV" "$IP6V"; do
    iptables="${iptables}" && {
      stop_redirect
      stop_tproxy
      stop_tun_bypass
      forward -D
    } > /dev/null 2>&1

    if [ "${iptables}" = "$IP6V" ]; then
      ${iptables} -D OUTPUT -p udp --destination-port 53 -j DROP > /dev/null 2>&1
    fi
  done
}

log_iptables_results() {
  [ "${network_mode}" = "tun" ] && return 0
  log Info "操作: 添加 iptables 规则"

  local applied_uids
  applied_uids=$(cat "${uid_list}" 2>/dev/null | tr '\n' ' ')

  if [ -n "$applied_uids" ]; then
    log Debug "应用的 UIDs: $applied_uids"
  else
    case "$proxy_mode" in
      core)
        log Debug "(核心模式, 所有应用透明代理)" ;;
      whitelist|white)
        log Debug "(列表为空, 代理所有应用)" ;;
      *)
        log Debug "(列表为空, 不代理任何应用)" ;;
    esac
  fi
}

log_iptables_cleanup() {
  log Info "操作: 清理 iptables 规则"
}

if [[ "${network_mode}" == @(redirect|mixed|tproxy|enhance) ]]; then
  case "$1" in
    enable|renew)
      apply_capability_downgrades
      log_context
      box_etc
      log Info "$IPV + $IP6V"
      probe_user_group || {
        log Error "检测 BOX 用户组失败，请确保 ${bin_name} 内核已启动。"
      }
      log_iptables_results
      cleanup_iptables

      setup_localnet_ipset

      if [ "${bypass_cn_ip}" = "true" ]; then
        setup_cn_ipset || log Warning "CN IP 分流初始化失败，已跳过"
      fi

      clean_google_fw_rules

      [ $1 = "renew" ] && log Warning "正在清理 iptables 透明代理规则。"

      case "${network_mode}" in
        tproxy)
          log Info "使用 Tproxy: tcp + udp。"
          log Info "正在创建 iptables 透明代理规则。"

          iptables="$IPV"
          if start_tproxy; then
            log Info "iptables 透明代理规则创建完成。"
          else
            log Error "iptables 透明代理规则创建失败。"
            stop_tproxy > /dev/null 2>&1
          fi

          if [ "${ipv6}" = "true" ]; then
            log Debug "启用 IPv6。"
            ipv6_enable
            iptables="$IP6V"

            if start_tproxy; then
              log Info "ip6tables 透明代理规则创建完成。"
            else
              log Error "ip6tables 透明代理规则创建失败。"
              stop_tproxy > /dev/null 2>&1
            fi
          else
            disable_ipv6
            log Warning "已禁用 IPv6。"
          fi

          [ "${quic}" = "disable" ] && block_quic enable
        ;;
        redirect)
          log Info "使用 Redirect: tcp + udp（直连）。"
          log Info "正在创建 iptables 透明代理规则。"

          iptables="$IPV"
          if start_redirect; then
            log Info "iptables 透明代理规则创建完成。"
          else
            log Error "iptables 透明代理规则创建失败。"
            stop_redirect > /dev/null 2>&1
          fi

          if [ "${ipv6}" = "true" ]; then
            log Debug "启用 IPv6。"
            ipv6_enable
            iptables="$IP6V"

            if start_redirect; then
              log Info "ip6tables 透明代理规则创建完成。"
            else
              log Error "ip6tables 透明代理规则创建失败。"
              stop_redirect > /dev/null 2>&1
            fi
          else
            disable_ipv6
            log Warning "已禁用 IPv6。"
          fi
        ;;
        mixed)
          log Info "使用 Mixed: tcp(redirect) + udp(tun)。"
          log Info "正在创建 iptables 透明代理规则。"

          iptables="$IPV"
          probe_tun_device || log Error "未找到 TUN 设备: (${tun_device})"
          forward -I || forward -D > /dev/null 2>&1

          if start_redirect; then
            log Info "iptables 透明代理规则创建完成。"
          else
            log Error "iptables 透明代理规则创建失败。"
            stop_redirect > /dev/null 2>&1
          fi

          if [ "${ipv6}" = "true" ]; then
            log Debug "启用 IPv6。"
            ipv6_enable
            iptables="$IP6V"
            forward -I || forward -D > /dev/null 2>&1
            if start_redirect; then
              log Info "ip6tables 透明代理规则创建完成。"
            else
              log Error "ip6tables 透明代理规则创建失败。"
              stop_redirect > /dev/null 2>&1
            fi
          else
            disable_ipv6
            log Warning "已禁用 IPv6。"
          fi
        ;;
        enhance)
          log Info "使用 Enhance: tcp(redirect) + udp(tproxy)"
          log Info "正在创建 iptables 透明代理规则。"

          iptables="$IPV"
          if start_redirect && start_tproxy; then
            log Info "iptables 透明代理规则创建完成。"
          else
            log Error "iptables 透明代理规则创建失败。"
            stop_redirect > /dev/null 2>&1
          fi

          if [ "${ipv6}" = "true" ]; then
            log Debug "启用 IPv6。"
            ipv6_enable
            iptables="$IP6V"
            if start_redirect && start_tproxy; then
              log Info "ip6tables 透明代理规则创建完成。"
            else
              log Error "ip6tables 透明代理规则创建失败。"
              stop_redirect > /dev/null 2>&1
            fi
          else
            disable_ipv6
            log Warning "已禁用 IPv6。"
          fi
        ;;
        *)
          log Error "network_mode: ${network_mode}，未知模式"
          exit 1
        ;;
      esac
      [ $1 = "renew" ] && log Debug "重启 iptables 透明代理规则完成。"
      bin_alive && log Info "${bin_name} 已连接。"
      runtime_save
      ;;
    disable)
      runtime_load 2>/dev/null || true
      ipv6_enable
      probe_user_group || log Error "检测 BOX 用户组失败，请确保 ${bin_name} 内核已启动。"
      log_iptables_cleanup
      log Warning "正在清理 iptables 透明代理规则。"

      cleanup_iptables
      runtime_clear

      log Warning "iptables 透明代理规则清理完成。"
      ;;
    purge)
      log Warning "正在清理所有 ipset..."
      cleanup_cn_ipset
      cleanup_localnet_ipset
      log Warning "ipset 清理完成"
      ;;
    hotswap_cn)
      log Info "开始 CN IP 热更新..."
      hotswap_cn_ipset
      log Info "CN IP 热更新完成"
      ;;
    clean_google)
      clean_google_fw_rules
      ;;
    *)
      echo "${red}$0 $1 未知命令${normal}"
      echo "${yellow}用法:${normal} ${green}$0${normal} {${yellow}enable|disable|renew${normal}}"
      ;;
  esac
else
  case "$1" in
    enable|renew)
      log_context
      box_etc
      log Info "$IPV + $IP6V"
      log Info "使用 Tun: tcp + udp。"

      probe_user_group || {
        log Error "检测 BOX 用户组失败，请确保 ${bin_name} 内核已启动。"
        exit 1
      }

      log_iptables_results
      cleanup_iptables
      
      setup_localnet_ipset
      if [ "${bypass_cn_ip}" = "true" ]; then
        setup_cn_ipset || log Warning "CN IP 分流初始化失败，已跳过"
      fi

      if ! probe_tun_device; then
        log Error "无法找到 TUN 设备: (${tun_device})，启动失败。"
        exit 1
      fi

      [ $1 = "renew" ] && log Warning "正在清理 TUN 规则。"
      
      iptables="$IPV"
      if forward -I && start_tun_bypass; then
        log Info "IPv4 TUN 规则创建完成。"
      else
        log Error "IPv4 TUN 规则创建失败。"
      fi

      if [ "${ipv6}" = "true" ]; then
        log Debug "启用 IPv6。"
        ipv6_enable
        iptables="$IP6V"
        if forward -I && start_tun_bypass; then
          log Info "IPv6 TUN 规则创建完成。"
        else
          log Error "IPv6 TUN 规则创建失败。"
        fi
      else
        disable_ipv6
        log Warning "已禁用 IPv6。"
      fi

      [ $1 = "renew" ] && log Info "重启 iptables TUN 规则完成。"
      bin_alive && log Info "${bin_name} 已连接。"
      runtime_save
      ;;
    disable)
      runtime_load 2>/dev/null || true
      ipv6_enable
      probe_user_group || log Error "检测 BOX 用户组失败，请确保 ${bin_name} 内核已启动。"
      log_iptables_cleanup
      log Warning "正在清理 TUN 规则。"

      cleanup_iptables
      runtime_clear

      log Warning "TUN 规则清理完成。"
      ;;
    *)
      echo "${red}$0: '$1' 未知命令${normal}"
      echo "${yellow}用法:${normal} ${green}$0${normal} {${yellow}enable|disable|renew${normal}}"
      ;;
  esac
fi
